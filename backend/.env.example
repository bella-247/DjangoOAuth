# Django core
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Frontend origin (must match exactly)
DJANGO_FRONTEND_URL=http://localhost:5173
# Use "cross-domain" when frontend and backend are on unrelated domains.
DJANGO_AUTH_MODE=cross-domain

# Cross-origin requests (CORS)
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173

# CSRF trusted origins (for allauth redirect validation)
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173

# OAuth providers to enable (comma-separated)
# Supported: google, github, gitlab, microsoft
DJANGO_AUTH_PROVIDERS=google

# Google OAuth credentials (from Google Cloud Console)
# Create a Web Application client at https://console.cloud.google.com/auth/clients
# Authorized redirect URI: http://localhost:8000/accounts/google/login/callback/
DJANGO_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
DJANGO_GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth credentials (from GitHub Developer Settings)
# Create an OAuth App at https://github.com/settings/developers
# Authorization callback URL: http://localhost:8000/accounts/github/login/callback/
DJANGO_GITHUB_CLIENT_ID=your-github-client-id
DJANGO_GITHUB_CLIENT_SECRET=your-github-client-secret

# GitLab OAuth credentials (from GitLab Applications)
# Create an Application at https://gitlab.com/-/applications
# Redirect URI: http://localhost:8000/accounts/gitlab/login/callback/
DJANGO_GITLAB_CLIENT_ID=your-gitlab-client-id
DJANGO_GITLAB_CLIENT_SECRET=your-gitlab-client-secret

# Microsoft OAuth credentials (from Azure Portal)
# Create an App Registration at https://portal.azure.com/
# Redirect URI: http://localhost:8000/accounts/microsoft/login/callback/
DJANGO_MICROSOFT_CLIENT_ID=your-microsoft-client-id
DJANGO_MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret

# Production security settings (set to True/values for production)
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SESSION_COOKIE_DOMAIN=
DJANGO_SESSION_COOKIE_SAMESITE=Lax
DJANGO_CSRF_COOKIE_SAMESITE=Lax
DJANGO_ACCESS_TOKEN_LIFETIME_SECONDS=3600

# Email backend
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend